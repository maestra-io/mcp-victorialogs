# syntax=docker/dockerfile:1

# Build stage
FROM golang:1.26-alpine AS builder
WORKDIR /app

# Install Git for potential dependencies and ca-certificates
# BASE_REFRESH (CI passes the ISO week): the layer cache would otherwise serve
# this stage forever, without apk/OS security updates. A new value rebuilds it
# on the next build.
ARG BASE_REFRESH
RUN --mount=type=secret,id=PRIVATE_PACKAGES_TOKEN,required=true --mount=type=bind,from=public.ecr.aws/g5f9s8a4/nora-apk:1.0.0@sha256:55df38687c301e6fefa230dc1c71a8841618214cc549ade71be740b25822a00e,target=/nora-apk \
    /nora-apk/nora-apk add --no-cache git ca-certificates nodejs npm

# Dependencies before the sources, so a source-only change reuses the cached
# go mod download / npm install layers.
COPY go.mod go.sum ./
# Modules through nora (packages.maestra.io, 3-day hold, issues-maestra#1649): CI passes
# its token as the PRIVATE_PACKAGES_TOKEN secret; a local build keeps the default proxy.
RUN --mount=type=secret,id=PRIVATE_PACKAGES_TOKEN,env=NORA_TOKEN \
    GOPROXY="${NORA_TOKEN:+https://token:${NORA_TOKEN}@packages.maestra.io/go}" go mod download
COPY web/package.json web/package-lock.json ./web/
RUN cd web && npm install

# Copy source
COPY . .

# Build UI
RUN cd web && npm run build

# Build
RUN go build -o mcp-victorialogs ./cmd/mcp-victorialogs

# Runtime stage
FROM alpine:latest
WORKDIR /app

# Install ca-certificates for HTTPS
ARG BASE_REFRESH
RUN --mount=type=secret,id=PRIVATE_PACKAGES_TOKEN,required=true --mount=type=bind,from=public.ecr.aws/g5f9s8a4/nora-apk:1.0.0@sha256:55df38687c301e6fefa230dc1c71a8841618214cc549ade71be740b25822a00e,target=/nora-apk \
    /nora-apk/nora-apk add --no-cache ca-certificates

# Copy binary from builder
COPY --from=builder /app/mcp-victorialogs /usr/local/bin/mcp-victorialogs

# Default entrypoint
ENTRYPOINT ["mcp-victorialogs"]
